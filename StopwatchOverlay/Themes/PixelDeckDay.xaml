<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingBrush x:Key="AppBackgroundBrush" TileMode="Tile"
                  ViewportUnits="Absolute" Viewport="0,0,16,16"
                  ViewboxUnits="Absolute" Viewbox="0,0,16,16">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#8BD2DF">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#243B98B5">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#30087A8D">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="8,8,8,8"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#704022"/>
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#F0D39A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF7DF"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFDF5"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EFE0BB"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#F7D992"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#58371F"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#9E7047"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D2630"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#53616B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#087A8D"/>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#075466"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#0A6F78"/>
    <SolidColorBrush x:Key="OnActionTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerActionBrush" Color="#A91D2F"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A91D2F"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#176B43"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9A5C00"/>
    <SolidColorBrush x:Key="MutedStatusBrush" Color="#6B7580"/>
    <SolidColorBrush x:Key="RecBrush" Color="#B62D3C"/>
    <SolidColorBrush x:Key="ThemeShadowBrush" Color="#704022"/>
    <SolidColorBrush x:Key="OverlayChromeBrush" Color="#F0075466"/>
    <SolidColorBrush x:Key="OverlayChromeBorderBrush" Color="#F0D39A"/>
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#0A6F78"/>
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#704022"/>

    <FontFamily x:Key="AppFontFamily">Inter</FontFamily>
    <FontFamily x:Key="ThemeMonoFontFamily">Cascadia Mono</FontFamily>
    <FontFamily x:Key="ThemeTimerFontFamily">Cascadia Mono</FontFamily>

    <Thickness x:Key="ThemeControlBorderThickness">2</Thickness>
    <Thickness x:Key="ThemePanelBorderThickness">2</Thickness>
    <Thickness x:Key="ThemeButtonShadowMargin">3,4,0,0</Thickness>
    <Thickness x:Key="ThemeOverlayPadding">15,10</Thickness>
    <Thickness x:Key="ThemeOverlayFrameBorderThickness">2</Thickness>
    <Thickness x:Key="ThemeOverlayButtonBorderThickness">2</Thickness>
    <CornerRadius x:Key="ThemeControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeItemCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="ThemePopupCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemePanelCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeCardCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeCheckCornerRadius">1</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayButtonCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="ThemeTimerPanelCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeDashboardCardCornerRadius">3</CornerRadius>
    <DropShadowEffect x:Key="ThemePanelShadowEffect"
                      Color="#704022" BlurRadius="0" Direction="315"
                      ShadowDepth="6" Opacity="0.9"/>
</ResourceDictionary>
