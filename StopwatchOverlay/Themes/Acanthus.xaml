<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <DrawingBrush x:Key="AppBackgroundBrush" TileMode="Tile"
                  ViewportUnits="Absolute" Viewport="0,0,24,24"
                  ViewboxUnits="Absolute" Viewbox="0,0,24,24">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F3EFE5">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FBF8F1"/>
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#445140"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FBF8F1"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#E5DDCF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#D5DDCF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#D5DDCF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#B08A4D"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#B8B0A2"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#2C2924"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#706A61"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#445140"/>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#2C2924"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#445140"/>
    <SolidColorBrush x:Key="OnActionTextBrush" Color="#FBF8F1"/>
    <SolidColorBrush x:Key="DangerActionBrush" Color="#8A3E45"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#8A3E45"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4F755A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9B6D35"/>
    <SolidColorBrush x:Key="MutedStatusBrush" Color="#706A61"/>
    <SolidColorBrush x:Key="RecBrush" Color="#8A3E45"/>
    <SolidColorBrush x:Key="ThemeShadowBrush" Color="#24445140"/>
    <SolidColorBrush x:Key="OverlayChromeBrush" Color="#D1FBF8F1"/>
    <SolidColorBrush x:Key="OverlayChromeBorderBrush" Color="#B08A4D"/>
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#D5DDCF"/>
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#D1BC8D"/>
    <SolidColorBrush x:Key="OverlayActionForegroundBrush" Color="#445140"/>
    <SolidColorBrush x:Key="NeutralButtonHoverBackgroundBrush" Color="#D5DDCF"/>
    <SolidColorBrush x:Key="NeutralButtonHoverBorderBrush" Color="#B08A4D"/>
    <SolidColorBrush x:Key="NeutralButtonHoverForegroundBrush" Color="#2C2924"/>
    <SolidColorBrush x:Key="NeutralButtonPressedBackgroundBrush" Color="#E5DDCF"/>
    <SolidColorBrush x:Key="NeutralButtonPressedBorderBrush" Color="#B08A4D"/>
    <SolidColorBrush x:Key="NeutralButtonPressedForegroundBrush" Color="#2C2924"/>
    <sys:Double x:Key="NeutralButtonHoverOpacity">1</sys:Double>
    <sys:Double x:Key="NeutralButtonPressedOpacity">1</sys:Double>

    <SolidColorBrush x:Key="ApplicationHeaderBrush" Color="#FBF8F1"/>
    <SolidColorBrush x:Key="NavigationRailBrush" Color="#D5DDCF"/>
    <SolidColorBrush x:Key="SelectedNavigationBrush" Color="#FBF8F1"/>
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#E5DDCF"/>
    <SolidColorBrush x:Key="ChartSeries1Brush" Color="#4F755A"/>
    <SolidColorBrush x:Key="ChartSeries2Brush" Color="#B08A4D"/>
    <SolidColorBrush x:Key="ChartSeries3Brush" Color="#71806A"/>
    <SolidColorBrush x:Key="ChartSeries4Brush" Color="#8A3E45"/>
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FBF8F1"/>
    <SolidColorBrush x:Key="OverlayInnerRuleBrush" Color="#D1BC8D"/>
    <SolidColorBrush x:Key="OverlayToolbarSurfaceBrush" Color="#FBF8F1"/>
    <SolidColorBrush x:Key="OrnamentStrokeBrush" Color="#B08A4D"/>
    <SolidColorBrush x:Key="OrnamentAccentBrush" Color="#445140"/>
    <SolidColorBrush x:Key="ActiveItemBorderBrush" Color="#445140"/>
    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#D1BC8D"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#4F755A"/>

    <FontFamily x:Key="AppFontFamily">pack://application:,,,/StopwatchOverlay;component/Assets/Fonts/Acanthus/#Inter</FontFamily>
    <FontFamily x:Key="DisplayHeadingFontFamily">pack://application:,,,/StopwatchOverlay;component/Assets/Fonts/Acanthus/#Cormorant Garamond</FontFamily>
    <FontFamily x:Key="ThemeMonoFontFamily">pack://application:,,,/StopwatchOverlay;component/Assets/Fonts/Acanthus/#Cascadia Mono</FontFamily>
    <FontFamily x:Key="ThemeTimerFontFamily">pack://application:,,,/StopwatchOverlay;component/Assets/Fonts/Acanthus/#Cascadia Mono</FontFamily>

    <Visibility x:Key="OrnamentVisibility">Visible</Visibility>
    <Visibility x:Key="BrandIconVisibility">Collapsed</Visibility>
    <Thickness x:Key="ThemeControlBorderThickness">1</Thickness>
    <Thickness x:Key="ThemePanelBorderThickness">1</Thickness>
    <Thickness x:Key="ThemeButtonShadowMargin">0</Thickness>
    <Thickness x:Key="ThemeOverlayPadding">18,10,18,12</Thickness>
    <Thickness x:Key="ThemeOverlayFrameBorderThickness">1</Thickness>
    <Thickness x:Key="ThemeOverlayButtonBorderThickness">0</Thickness>
    <CornerRadius x:Key="ThemeControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeItemCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="ThemePopupCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemePanelCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ThemeCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeCheckCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayButtonCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="ThemeTimerPanelCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ThemeDashboardCardCornerRadius">8</CornerRadius>
    <DropShadowEffect x:Key="ThemePanelShadowEffect"
                      Color="#445140" BlurRadius="12" Direction="270"
                      ShadowDepth="3" Opacity="0.07"/>
</ResourceDictionary>
