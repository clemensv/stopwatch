<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingBrush x:Key="AppBackgroundBrush" TileMode="Tile"
                  ViewportUnits="Absolute" Viewport="0,0,1,1"
                  ViewboxUnits="Absolute" Viewbox="0,0,1,1">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#F4F7F8">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#EDF3F6"/>
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#34434D"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F4F7F8"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E7EEF2"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#D8ECF4"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#7A8994"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#9AAAB4"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172129"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5C6B74"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#117A9C"/>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#117A9C"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#1976A3"/>
    <SolidColorBrush x:Key="OnActionTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerActionBrush" Color="#C43C3C"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#237A47"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#A76100"/>
    <SolidColorBrush x:Key="MutedStatusBrush" Color="#76838B"/>
    <SolidColorBrush x:Key="RecBrush" Color="#D9363E"/>
    <SolidColorBrush x:Key="ThemeShadowBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="OverlayChromeBrush" Color="#F00F2733"/>
    <SolidColorBrush x:Key="OverlayChromeBorderBrush" Color="#8BB7C6"/>
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#2FFFFFFF"/>
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#4AFFFFFF"/>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="ThemeMonoFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="ThemeTimerFontFamily">Consolas</FontFamily>

    <Thickness x:Key="ThemeControlBorderThickness">1</Thickness>
    <Thickness x:Key="ThemePanelBorderThickness">1</Thickness>
    <Thickness x:Key="ThemeButtonShadowMargin">0</Thickness>
    <Thickness x:Key="ThemeOverlayPadding">15,8</Thickness>
    <Thickness x:Key="ThemeOverlayFrameBorderThickness">1</Thickness>
    <Thickness x:Key="ThemeOverlayButtonBorderThickness">1</Thickness>
    <CornerRadius x:Key="ThemeControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ThemeItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ThemePopupCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="ThemePanelCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="ThemeCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeCheckCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayButtonCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="ThemeTimerPanelCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ThemeDashboardCardCornerRadius">10</CornerRadius>
    <DropShadowEffect x:Key="ThemePanelShadowEffect"
                      Color="#5C6B74" BlurRadius="6" Direction="315"
                      ShadowDepth="2" Opacity="0.16"/>
</ResourceDictionary>
