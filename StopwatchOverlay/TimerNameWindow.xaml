<Window x:Class="StopwatchOverlay.TimerNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose project"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="22">
        <TextBlock Text="Choose a project" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="The timer name becomes its project. Time is recorded while this timer is running."
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" Margin="0,5,0,18"/>

        <TextBlock Text="Project" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,7"/>
        <ComboBox x:Name="ProjectSelector"
                  MinHeight="44"
                  SelectionChanged="ProjectSelector_SelectionChanged"
                  KeyDown="ProjectSelector_KeyDown"/>

        <Border x:Name="NewProjectPanel"
                Style="{StaticResource SettingsCard}"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="New project name"
                           Style="{StaticResource SectionHeaderText}"
                           Margin="0,0,0,7"/>
                <TextBox x:Name="NewProjectBox"
                         MaxLength="60"
                         MinHeight="42"
                         Style="{StaticResource TimeInputBox}"
                         VerticalContentAlignment="Center"
                         KeyDown="NewProjectBox_KeyDown"/>
                <TextBlock x:Name="ValidationText"
                           Text="Enter a project name."
                           Foreground="{DynamicResource DangerTextBrush}"
                           Margin="2,7,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Choose ‘No project’ to keep this timer out of reports."
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" Margin="2,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ModernButton}"
                    IsCancel="True"
                    MinWidth="86" Margin="0,0,8,0"/>
            <Button Content="Use project" Click="Save_Click" Style="{StaticResource StartButton}"
                    IsDefault="True"
                    MinWidth="112"/>
        </StackPanel>
    </StackPanel>
</Window>
