<Window x:Class="StopwatchOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings and Overlay Inspector"
        Width="1040" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="52"
                Background="{DynamicResource ApplicationHeaderBrush}"
                BorderBrush="{DynamicResource SubtleDividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="28" Height="28" Margin="0,0,10,0"
                          Data="{StaticResource AcanthusCrestGeometry}"
                          Fill="{DynamicResource OrnamentAccentBrush}"
                          Stretch="Uniform" Visibility="{DynamicResource OrnamentVisibility}"/>
                    <TextBlock Text="Settings &amp; Overlay Inspector" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Content="Done" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="34" Padding="16,4" Style="{StaticResource StartButton}"
                        Click="DoneButton_Click"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="156"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleDividerBrush}" BorderThickness="0,0,1,0"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Live overlay preview" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Only the timer surface responds to background opacity."
                                   Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Border x:Name="PreviewSurface" HorizontalAlignment="Center"
                                MinWidth="324" Padding="18,12"
                                BorderBrush="{DynamicResource OverlayChromeBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}">
                            <StackPanel>
                                <TextBlock x:Name="PreviewTimeText" Text="00:05:10"
                                           HorizontalAlignment="Center"
                                           FontFamily="{DynamicResource ThemeTimerFontFamily}"
                                           FontSize="48" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PreviewProjectText" Text="Programming"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"
                                           FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="42,0" BorderBrush="{DynamicResource OverlayInnerRuleBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Visibility="{DynamicResource OrnamentVisibility}" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <Border HorizontalAlignment="Center" Padding="6"
                                Background="{DynamicResource OverlayToolbarSurfaceBrush}"
                                BorderBrush="{DynamicResource OverlayChromeBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}" Margin="0,0,0,14">
                            <TextBlock Text="✕     ⏸     ↺" Foreground="{DynamicResource OverlayActionForegroundBrush}"
                                       FontSize="16" ToolTip="Close, Pause or Resume, Reset"/>
                        </Border>
                        <Button Content="Show or hide active overlay" Style="{StaticResource ModernButton}"
                                Click="ShowOverlayButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource NavigationRailBrush}"
                    BorderBrush="{DynamicResource SubtleDividerBrush}" BorderThickness="0,0,1,0"
                    Padding="10,20">
                <ListBox x:Name="NavigationList" SelectedIndex="0"
                         SelectionChanged="NavigationList_SelectionChanged"
                         Background="Transparent" BorderThickness="0">
                    <ListBoxItem Content="Overlay &amp; position" Tag="Overlay" Padding="10"/>
                    <ListBoxItem Content="Appearance" Tag="Appearance" Padding="10"/>
                    <ListBoxItem Content="Light ring" Tag="LightRing" Padding="10"/>
                    <ListBoxItem Content="Behavior" Tag="Behavior" Padding="10"/>
                    <ListBoxItem Content="Application" Tag="Application" Padding="10"/>
                </ListBox>
            </Border>

            <ScrollViewer x:Name="SettingsScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="True">
                <Grid Margin="28,24">
                    <StackPanel x:Name="OverlayPanel">
                        <TextBlock Text="Overlay &amp; Position" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Choose where the floating timer appears and how it interacts with capture."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Display" Style="{StaticResource SectionHeaderText}"/>
                                <ComboBox x:Name="ScreenCombo" Margin="0,6,0,14"/>
                                <TextBlock Text="Position" Style="{StaticResource SectionHeaderText}"/>
                                <ComboBox x:Name="PositionCombo" Margin="0,6,0,14"/>
                                <CheckBox x:Name="ClickThroughCheck" Content="Click-through" Margin="0,4,0,12"/>
                                <CheckBox x:Name="HideOverlayCaptureCheck"
                                          Content="Hide floating timer from screen capture"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                        <TextBlock Text="Appearance &amp; Background" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Theme resources update every open app surface immediately."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource SectionHeaderText}"/>
                                <ComboBox x:Name="ThemeCombo" Margin="0,6,0,14"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,12"><TextBlock Text="Text color" Style="{StaticResource SectionHeaderText}"/><ComboBox x:Name="TextColorCombo" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Margin="8,0,0,12"><TextBlock Text="Outline color" Style="{StaticResource SectionHeaderText}"/><ComboBox x:Name="BorderColorCombo" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,8,12"><TextBlock Text="Timer font" Style="{StaticResource SectionHeaderText}"/><ComboBox x:Name="FontCombo" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Margin="8,0,0,12"><TextBlock Text="Time format" Style="{StaticResource SectionHeaderText}"/><ComboBox x:Name="FormatCombo" Margin="0,6,0,0"/></StackPanel>
                                </UniformGrid>
                                <Grid>
                                    <TextBlock Text="Text size" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock x:Name="TextSizeValueText" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                                <Slider x:Name="TextSizeSlider" Minimum="16" Maximum="120"
                                        SmallChange="1" LargeChange="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,12"
                                        AutomationProperties.Name="Timer text size"/>
                                <Grid>
                                    <TextBlock Text="Outline thickness" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock x:Name="BorderWidthValueText" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                                <Slider x:Name="BorderWidthSlider" Minimum="1" Maximum="5"
                                        SmallChange="1" LargeChange="1" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,12"
                                        AutomationProperties.Name="Timer outline thickness"/>
                                <Grid>
                                    <TextBlock Text="Timer surface opacity" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock x:Name="BackgroundOpacityValueText" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                                <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100"
                                        SmallChange="1" LargeChange="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,14"
                                        AutomationProperties.Name="Timer surface opacity"/>
                                <TextBlock Text="Application background" Style="{StaticResource SectionHeaderText}"/>
                                <Grid Margin="0,6,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="BackgroundCombo" DisplayMemberPath="DisplayLabel"/>
                                    <Button Grid.Column="1" Content="Add" Height="40" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Click="AddBackgroundButton_Click"/>
                                    <Button x:Name="RemoveBackgroundButton" Grid.Column="2" Content="Remove" Height="40" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Click="RemoveBackgroundButton_Click"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Background strength" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock x:Name="BackgroundStrengthValueText" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                                <Slider x:Name="BackgroundStrengthSlider" Minimum="10" Maximum="45"
                                        SmallChange="1" LargeChange="5" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                        AutomationProperties.Name="Application background strength"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LightRingPanel" Visibility="Collapsed">
                        <TextBlock Text="Light Ring" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="A capture-aware guide around the selected display."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="LightRingEnabledCheck" Content="Enable light ring" Margin="0,0,0,16"/>
                            <Grid>
                                <TextBlock Text="Brightness" Style="{StaticResource SectionHeaderText}"/>
                                <TextBlock x:Name="LightRingBrightnessValueText" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Grid>
                            <Slider x:Name="LightRingBrightnessSlider" Minimum="10" Maximum="100"
                                    SmallChange="1" LargeChange="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,6,0,16"
                                    AutomationProperties.Name="Light ring brightness"/>
                            <Grid>
                                <TextBlock Text="Ring width" Style="{StaticResource SectionHeaderText}"/>
                                <TextBlock x:Name="LightRingWidthValueText" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Grid>
                            <Slider x:Name="LightRingWidthSlider" Minimum="5" Maximum="100"
                                    SmallChange="1" LargeChange="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,6,0,16"
                                    AutomationProperties.Name="Light ring width"/>
                            <CheckBox x:Name="LightRingCaptureCheck" Content="Hide ring from screen capture"/>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="BehaviorPanel" Visibility="Collapsed">
                        <TextBlock Text="Behavior" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Keep recording and presentation workflows predictable."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="AutoStartCheck" Content="Auto-start when the overlay is shown" Margin="0,0,0,14"/>
                            <CheckBox x:Name="RecCheck" Content="Show REC indicator" Margin="0,0,0,14"/>
                            <CheckBox x:Name="BlinkCheck" Content="Blink timer colon" Margin="0,0,0,14"/>
                            <CheckBox x:Name="SmartInputCheck" Content="Use smart countdown input"/>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="ApplicationPanel" Visibility="Collapsed">
                        <TextBlock Text="Application" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Startup and persistence preferences."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"/>
                            <TextBlock Text="Your theme, backgrounds, timers, project history, positions, and shortcuts remain stored by the existing recovery system."
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        </StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
