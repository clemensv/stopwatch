<Window x:Class="StopwatchOverlay.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="16">
        <TextBlock Text="Click a box and press a key combo. Use Clear to unbind (button still works on-screen)."
                   TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start/Stop:" VerticalAlignment="Center" Margin="0,0,10,6"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="StartStopShortcutBox" IsReadOnly="True" Margin="0,0,8,6"
                     Tag="StartStop" GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" PreviewKeyDown="ShortcutBox_PreviewKeyDown"/>
            <Button Grid.Row="0" Grid.Column="2" Content="Clear" Tag="StartStop" Click="ClearShortcut_Click" Style="{StaticResource ModernButton}" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Reset:" VerticalAlignment="Center" Margin="0,0,10,6"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ResetShortcutBox" IsReadOnly="True" Margin="0,0,8,6"
                     Tag="Reset" GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" PreviewKeyDown="ShortcutBox_PreviewKeyDown"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Clear" Tag="Reset" Click="ClearShortcut_Click" Style="{StaticResource ModernButton}" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Toggle Overlay:" VerticalAlignment="Center" Margin="0,0,10,6"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ToggleOverlayShortcutBox" IsReadOnly="True" Margin="0,0,8,6"
                     Tag="ToggleOverlay" GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" PreviewKeyDown="ShortcutBox_PreviewKeyDown"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Clear" Tag="ToggleOverlay" Click="ClearShortcut_Click" Style="{StaticResource ModernButton}" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Lap:" VerticalAlignment="Center" Margin="0,0,10,6"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="LapShortcutBox" IsReadOnly="True" Margin="0,0,8,6"
                     Tag="Lap" GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" PreviewKeyDown="ShortcutBox_PreviewKeyDown"/>
            <Button Grid.Row="3" Grid.Column="2" Content="Clear" Tag="Lap" Click="ClearShortcut_Click" Style="{StaticResource ModernButton}" Margin="0,0,0,6"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset to defaults" Click="ResetDefaults_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,0" MinWidth="80"/>
            <Button Content="Save" Click="Save_Click" Style="{StaticResource StartButton}" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
