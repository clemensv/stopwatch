<Window x:Class="StopwatchOverlay.ProjectDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project time overview"
        Width="1120" Height="800"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThemePanelBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ThemeDashboardCardCornerRadius}"/>
            <Setter Property="Effect" Value="{DynamicResource ThemePanelShadowEffect}"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource DashboardCard}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="RangeButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ChartTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Project time" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="A clear view of where your time went"
                               Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource ModernButton}" Height="34"
                        Padding="13,5" FontSize="12" VerticalAlignment="Center"
                        Click="RefreshButton_Click"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,14,16,0">
                    <TextBlock Text="Project" Style="{StaticResource Caption}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ProjectFilterSelector" Width="230" Height="34" MinHeight="34"
                              ToolTip="Filter every dashboard view by project"
                              SelectionChanged="ProjectFilterSelector_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,14,0,0">
                    <Button x:Name="TodayButton" Content="Today" Style="{StaticResource RangeButton}"
                            Tag="Today" Click="RangeButton_Click"/>
                    <Button x:Name="SevenDaysButton" Content="7 days" Style="{StaticResource RangeButton}"
                            Tag="SevenDays" Click="RangeButton_Click"/>
                    <Button x:Name="ThirtyDaysButton" Content="30 days" Style="{StaticResource RangeButton}"
                            Tag="ThirtyDays" Click="RangeButton_Click"/>
                    <Button x:Name="AllTimeButton" Content="All time" Style="{StaticResource RangeButton}"
                            Tag="AllTime" Click="RangeButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalFirst">
            <Grid Margin="22,20,22,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RangeHeadingText" Text="Today" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UpdatedText" Grid.Column="1" Style="{StaticResource Caption}"
                               VerticalAlignment="Bottom" Margin="16,0,0,3"/>
                </Grid>

                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,-10,18">
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="TRACKED TIMER TIME" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TotalTrackedText" Text="0m" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock Text="Simultaneous timers are added" Style="{StaticResource Caption}"
                                       FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="SESSIONS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SessionCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="PROJECTS" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProjectCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ACTIVE NOW" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Ellipse Grid.Column="1" x:Name="ActiveStatusDot" Width="9" Height="9"
                                     Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="8,4,0,0"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Border x:Name="ProjectRecordsCard"
                        Grid.Row="2"
                        Style="{StaticResource DashboardCard}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        Margin="0,0,0,16"
                        Cursor="Hand"
                        ToolTip="Open the detailed project records page"
                        MouseLeftButtonUp="ProjectRecordsCard_MouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Project records" Style="{StaticResource ChartTitle}"/>
                            <TextBlock x:Name="ProjectRecordsScopeText"
                                       Text="All projects in the selected period"
                                       Style="{StaticResource Caption}"
                                       Margin="0,4,0,11"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProjectRecordsCountText"
                                           Text="0 records"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="  •  "
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProjectRecordsLatestText"
                                           Grid.Column="2"
                                           Text="No records here yet — open the records page to add one."
                                           Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Open records"
                                Style="{StaticResource ModernButton}"
                                Height="36"
                                Padding="15,6"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Click="OpenRecordsButton_Click"/>
                    </Grid>
                </Border>

                <Grid x:Name="ChartsGrid" Grid.Row="3" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,8,0" MinHeight="230">
                        <StackPanel>
                            <TextBlock Text="Time by project" Style="{StaticResource ChartTitle}"/>
                            <TextBlock Text="Compared within the selected period" Style="{StaticResource Caption}" Margin="0,4,0,16"/>
                            <StackPanel x:Name="ProjectBarsPanel"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="8,0,0,0" MinHeight="230">
                        <StackPanel>
                            <TextBlock Text="Daily totals" Style="{StaticResource ChartTitle}"/>
                            <TextBlock Text="Tracked time by local date" Style="{StaticResource Caption}" Margin="0,4,0,16"/>
                            <StackPanel x:Name="DailyBarsPanel"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="TimelineCard" Grid.Row="4" Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Daily timeline" Style="{StaticResource ChartTitle}"/>
                        <TextBlock Text="Each row spans 00:00–24:00; overlapping timers use separate lanes"
                                   Style="{StaticResource Caption}" Margin="0,4,0,16"/>
                        <StackPanel x:Name="TimelineDaysPanel"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SessionsCard" Grid.Row="5" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="Session details" Style="{StaticResource ChartTitle}"/>
                        <TextBlock Text="Start and finish times are shown in your local time zone"
                                   Style="{StaticResource Caption}" Margin="0,4,0,16"/>
                        <StackPanel x:Name="SessionsPanel"/>
                    </StackPanel>
                </Border>

                <Border x:Name="EmptyState" Grid.Row="6" Style="{StaticResource DashboardCard}"
                        Padding="28" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyStateHeadingText" Text="No tracked time in this period" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateDetailText" Text="Name a timer and start it. Its work sessions will appear here."
                                   Style="{StaticResource Caption}" Margin="0,7,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
